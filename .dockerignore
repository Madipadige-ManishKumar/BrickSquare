# Node modules (installed fresh in the image)
node_modules
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Git
.git
.gitignore
.gitattributes

# Python virtualenvs (ML service has its own Dockerfile)
venv
env
.venv
__pycache__
*.pyc
*.pyo
*.pyd

# Editor / IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Environment files (secrets must NOT be baked into the image)
.env
.env.*
!.env.example

