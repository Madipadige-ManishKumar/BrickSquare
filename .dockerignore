Dockerfile
docker-compose.yml
.dockerignore
Client/Dockerfile
Client/nginx.conf
Client/.dockerignore
ML-api/Dockerfile
ML-api/.dockerignore
ML-api/requirements.txt

# Distribution / build output
dist
dist-ssr

# Test files (not needed in production image)
api/test
Client/src/**/*.test.js
Client/src/**/*.test.jsx

